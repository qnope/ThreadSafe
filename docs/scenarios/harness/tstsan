#!/bin/zsh
# tstsan <file.cpp> [flags] -- build and run under ThreadSanitizer.
# GCC on macOS/arm64 ships no TSan runtime, so we compile with g++-16 (needed for
# -freflection) and link Apple clang's runtime explicitly. See docs/09-methodologie.md.
set -e
REPO="${THREADSAFE_ROOT:-${0:A:h}/../../..}"
TSANLIB="${TSAN_RUNTIME:-$(find /Library/Developer/CommandLineTools /Applications/Xcode.app \
    -name 'libclang_rt.tsan_osx_dynamic.dylib' 2>/dev/null | head -1)}"
if [[ -z "$TSANLIB" ]]; then
    print -u2 "tstsan: no libclang_rt.tsan_osx_dynamic.dylib found; set TSAN_RUNTIME"
    exit 1
fi
out="${TMPDIR:-/tmp}/${1:t:r}.tsan"
g++-16 -std=c++26 -freflection -O1 -g -pthread -fsanitize=thread \
    -I"$REPO/include" -c "$1" -o "$out.o" "${@:2}"
g++-16 -pthread "$out.o" "$TSANLIB" -Wl,-rpath,"${TSANLIB:h}" -o "$out"
TSAN_OPTIONS="${TSAN_OPTIONS:-halt_on_error=0}" "$out"
